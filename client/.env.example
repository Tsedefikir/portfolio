# Base URL for the backend API.
# Leave empty to use the Vite dev proxy (recommended during development).
# For a deployed frontend, set this to your API origin, e.g. https://api.example.com
VITE_API_URL=

# Formspree endpoint used by the contact form. Replace with your own form ID.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mkoybewq
